{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "declaration": true,
    "noEmit": true,
    "isolatedModules": true,
    "rootDir": "src",
    "baseUrl": ".",
    "paths": {
      "@anima/shared": ["./src/index.ts"],
      "@anima/shared/*": ["./src/*"]
    }
  },
  "include": ["src/**/*.ts"]
}
